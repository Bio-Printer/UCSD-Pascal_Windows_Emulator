# COMPFIX_BUILD.SCRIPT -- build the fixed compiler (COMPFIX.BLK on unit 9) with the
# installed compiler and install it with FIXUP. Clock off. Validation Check 15.

WAIT "Command:"
TYPE "F"
WAIT "Filer:"
TYPE "P"
WAIT "Prefix"
TYPE "#9:\r"
WAIT "Filer:"
TYPE "Q"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "COMPILER\r"
WAIT "To what codefile?"
TYPE "*SYSTEM.WRK\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "FIXUP\r"
WAIT "To what codefile?"
TYPE "FIXUP\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "FIXUP\r"
WAIT "FIXUP done."
WAIT "Command:"
