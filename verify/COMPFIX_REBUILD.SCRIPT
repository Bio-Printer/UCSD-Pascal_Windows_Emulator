# COMPFIX_REBUILD.SCRIPT -- with the NEW compiler and the PC's clock on: compile the
# compiler again (it must report time and lines/min without a floating point
# error) and install it with FIXUP again. Validation Check 15.

WAIT "Command:"
TYPE "F"
WAIT "Filer:"
TYPE "P"
WAIT "Prefix"
TYPE "#9:\r"
WAIT "Filer:"
TYPE "Q"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "COMPILER\r"
WAIT "To what codefile?"
TYPE "*SYSTEM.WRK\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "FIXUP\r"
WAIT "FIXUP done."
WAIT "Command:"
