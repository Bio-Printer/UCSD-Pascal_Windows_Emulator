# Disk units 11 and 12 (validation/run_all.sh Check 14): ERRTEST.BLK on unit
# 11, an empty volume on unit 12. The Filer must list both as on line; then
# STRCONST is compiled from #11 into #12 and run from there.
WAIT "Command:"
TYPE "F"
WAIT "Filer:"
TYPE "V"
WAIT "Filer:"
TYPE "L"
WAIT "Dir listing of what vol ?"
TYPE "#11:STRCONST.TEXT\r"
WAIT "Filer:"
TYPE "Q"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "#11:STRCONST\r"
WAIT "To what codefile?"
TYPE "#12:STRCONST\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "EMPTY:STRCONST\r"
WAIT "STRCONST: 13 OF 13 CHECKS TRUE"
WAIT "Command:"
