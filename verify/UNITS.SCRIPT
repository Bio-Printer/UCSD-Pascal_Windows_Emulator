# Disk units 11-14 (validation/run_all.sh Check 14): ERRTEST.BLK on units 11
# and 14 (DEEPC.C imported onto 14), an empty volume on units 12 and 13
# (EMPTY: and EMPTY2: -- II.0 cannot write a code file to the first of two
# volumes with the same name).
# The Filer must list all four as on line and G(et the C source DEEPC.C as
# the workfile (BIGGY's Filer: .C / .H keep their exact name); STRCONST is
# compiled from #11 into #12 and from #14 into #13, and run from there.
# Units 13 and 14 need the operating system with MAXUNIT = 14 (BIGGY 1.07).
WAIT "Command:"
TYPE "F"
WAIT "Filer:"
TYPE "V"
WAIT "Filer:"
TYPE "G"
WAIT "Get what file ?"
TYPE "#14:DEEPC.C\r"
WAIT "Text file loaded"
WAIT "Filer:"
TYPE "W"
WAIT "Workfile is ERRTEST:DEEPC.C"
WAIT "Filer:"
TYPE "N"
WAIT "Workfile cleared"
WAIT "Filer:"
TYPE "Q"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "#11:STRCONST\r"
WAIT "To what codefile?"
TYPE "#12:STRCONST\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#12:STRCONST\r"
WAIT "STRCONST: 13 OF 13 CHECKS TRUE"
WAIT "Command:"
TYPE "C"
WAIT "Compile what text?"
TYPE "#14:STRCONST\r"
WAIT "To what codefile?"
TYPE "#13:STRCONST\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#13:STRCONST\r"
WAIT "STRCONST: 13 OF 13 CHECKS TRUE"
WAIT "Command:"
