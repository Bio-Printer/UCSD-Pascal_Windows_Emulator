# E14: recursion stack overflow
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:E14\r"
WAIT "To what codefile?"
TYPE "#9:E14\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E14\r"
WAIT "E14 START"
WAIT "*STK OFLOW*"
WAIT "Command:"

# E15: NEW stack overflow
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:E15\r"
WAIT "To what codefile?"
TYPE "#9:E15\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E15\r"
WAIT "E15 START"
WAIT "*STK OFLOW*"
WAIT "Command:"

# E16: segment length 0 (no such segment) -- a damaged code file, see errtest/SEGERRS.README
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E16\r"
WAIT "ESEG START"
WAIT "Type <space>"
TYPE " "
WAIT "Command:"

# E17: segment block beyond the disk (read error) -- a damaged code file, see errtest/SEGERRS.README
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E17\r"
WAIT "ESEG START"
WAIT "Type <space>"
TYPE " "
WAIT "Command:"

# E18: segment block holds another segment -- a damaged code file, see errtest/SEGERRS.README
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E18\r"
WAIT "ESEG START"
WAIT "Type <space>"
TYPE " "
WAIT "Command:"

# E11: EXIT uncalled proc -- LAST: after this error the P-System halts. The
# failed EXIT has already rewritten every frame's return point up to the
# system's own, so the recovery EXIT(COMMAND) ends the operating system's main
# program, which returns to the ABORT opcode the boot put there (original
# UCSD II.0 behaviour; the emulator reports "The P-System has halted").
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:E11\r"
WAIT "To what codefile?"
TYPE "#9:E11\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E11\r"
WAIT "E11 START"
WAIT "Type <space>"
TYPE " "
HALTED
