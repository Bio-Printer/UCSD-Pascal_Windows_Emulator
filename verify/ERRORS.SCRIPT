# ERRORS.SCRIPT -- run-time error test suite for Verify P-System.

# Each program deliberately triggers one run-time error; the system's
# EXECERROR report is waited for and answered. Disks: #9 = ERRTEST.BLK.

WAIT "Command:"

# REALCMP: REAL comparisons EQU/NEQ/LES/LEQ/GRT/GEQ (type REALC) plus a NOT --
# a regression program (errtest/REALCMP.PAS.txt, REALCMP.CODE); no error.
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:REALCMP\r"
WAIT "REALCMP: 7 of 7 comparisons true"
WAIT "Command:"

# BYTECMP: PACKED ARRAY OF CHAR comparisons (type BYTEC) -- regression program.
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:BYTECMP\r"
WAIT "To what codefile?"
TYPE "#9:BYTECMP\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:BYTECMP\r"
WAIT "BYTECMP: 7 of 7 comparisons true"
WAIT "Command:"

# STRCONST: string and packed-array constants (LSA, LPA -- inline in the code)
# assigned, compared, passed, concatenated, in a segment procedure at every
# level of a recursion, and kept in a variable across segment calls -- a
# regression program for the Harvard layout, which copies them out of the
# code (errtest/STRCONST.TEXT, compiled by the script). No error.
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:STRCONST\r"
WAIT "To what codefile?"
TYPE "#9:STRCONST\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:STRCONST\r"
WAIT "STRCONST: 13 OF 13 CHECKS TRUE"
WAIT "Command:"

# DEEPCXP: a call into another segment (CXP) from more than 64 frames deep --
# the native CXP's static-link search gave up after 64 frames (errtest/DEEPCXP.README.md).
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:DEEPCXP\r"
WAIT "DEPTH 60: 1"
WAIT "DEPTH 70: 1"
WAIT "Command:"

# DEEPC: the same through Tiny-C code (errtest/DEEPC.C.txt).
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:DEEPC\r"
WAIT "depth 60: ok"
WAIT "depth 70: ok"
WAIT "Command:"

# DEEPCIP: the same-segment path (CIP) -- a nested function called 150 frames deep.
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:DEEPCIP\r"
WAIT "To what codefile?"
TYPE "#9:DEEPCIP\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:DEEPCIP\r"
WAIT "DEEPCIP: 101"
WAIT "Command:"
# E01: CHK value range
TYPE "C"
WAIT "Compile what text?"
TYPE "#9:E01\r"
WAIT "To what codefile?"
TYPE "#9:E01\r"
WAIT "Smallest available space"
WAIT "Command:"
TYPE "X"
WAIT "Execute what file?"
TYPE "#9:E01\r"
WAIT "E01 START"
WAIT "Type <space>"
TYPE " "
WAIT "Command:"

# E02: IXS string index
TYPE "C"
