// NativeCalli.inc -- CSP 138, CALLI: call through a function pointer.
// The Z80 interpreter has no such routine (its CSPTBL has 41 entries); in Z80
// mode the engine's coprocessor runs this same code for it
// (PSystemEngine::SetZ80Coprocessor, version 1.93).
// Included in PSystemEngine.cpp's CSP case, before NativeDouble.inc.
// Generated by Tiny-C (https://github.com/Bio-Printer/UCSD-C) for every call
// through a function pointer; earlier Tiny-C builds stored the function value
// into the operand bytes of a following CXP at run time instead (self-modifying
// code), which a machine with a separate instruction space cannot do.
//
//   138 CALLI  I fv -> (what the callee returns)
//       The arguments are on the stack exactly as for CXP; on top of them is
//       the function value fv = seg | proc << 8 (Tiny-C: LDCI, patched by the
//       linker). CALLI pops fv and does what CXP seg,proc would: the same
//       segment (CXP's CIP path), segment 0 (the OS), a resident segment, or a
//       segment that has to be read from disk first. The return IPC is the
//       instruction after the CSP. Nothing in the instruction stream is read
//       or written beyond the CSP itself.
//
// Cases the Z80 CXP would hand to real Z80 code (an assembly-language
// procedure, a stack overflow, a segment the native loader declines) have no
// Z80 CSP to fall back on here; they raise the matching run-time error instead
// (STKOVR, or NOPROC for the other two) with the stack as CXP would leave it.
// Whatever the engine's register-compatibility mode, nothing here sets the
// Z80 registers: there is no Z80 execution of CALLI to be compatible with.
if (procNum == 138) {
    const uint16_t calliFv  = PopStackWord();                        // the function value
    const uint8_t  segNum   = (uint8_t)(calliFv & 0xFF);
    const uint8_t  cxProcN  = (uint8_t)(calliFv >> 8);
    const uint16_t cxIpc1   = (uint16_t)(m_cpu.r.BC() + 1);          // BC is at the CSP number: the next instruction
    const uint16_t cxIpc2   = cxIpc1;                                // (for CXP these differ by the procedure byte)
    const uint16_t segp     = (uint16_t)(m_mem[PM_V(0x02F6)] | (m_mem[PM_V(0x02F7)] << 8));   // SEGP
    int cxWhy = 0;                                                   // see NativeCxp.inc
    m_cpu.r.setBC(cxIpc1);
    m_mem[PM_V(0x0246)] = cxIpc1 & 0xFF; m_mem[PM_V(0x0247)] = cxIpc1 >> 8;                 // SAVIPC
    m_opcodeEmulatedCount[OP_CSP]++;
    if (segNum != PM_CODE8(segp)) {
        // Another segment: CXP's own code (NativeCxp.inc).
#define CXP_POST cxPostCalli
#include "NativeCxp.inc"
#undef CXP_POST
        if (commit || m_cpu.r.PC != nativeEntryPc) break;            // done, or an error/Z80 continuation set PC
        // declined with nothing touched: raise the error the Z80 would reach
        m_cpu.r.PC = (cxWhy == 1) ? 0x03E9 : 0x03DF;                 // STKOVR : NOPROC (NativeErrors.inc)
        break;
    }
    // The same segment: CXP jumps to CIP, which is NativeBldmscw plus the
    // static-link fix-up (CIPXNL). This is OP_CIP with the procedure number and
    // return IPC given, and without the Z80 register bookkeeping.
    {
        if (!NativeBldmscwProc(cxProcN, cxIpc2)) {
            // STKOVR is already set as PC; an assembly-language procedure is not
            // supported through a function pointer
            if (m_cpu.r.PC == nativeEntryPc) m_cpu.r.PC = 0x03DF;   // NOPROC
            break;
        }
        const uint16_t newProcEntryAddr = m_cpu.r.BC();
        const uint16_t newMP   = (uint16_t)(m_mem[PM_V(0x02F2)] | (m_mem[PM_V(0x02F3)] << 8));
        const uint16_t newJtab = (uint16_t)(m_mem[PM_V(0x02F4)] | (m_mem[PM_V(0x02F5)] << 8));
        const uint8_t calledLexLevel = PM_CODE8((uint16_t)(newJtab + 1));
        if (((uint8_t)(calledLexLevel - 1) & 0x80) != 0) {            // base-level procedure: CBPXNL
            const uint16_t oldBASE = (uint16_t)(m_mem[PM_V(0x02F0)] | (m_mem[PM_V(0x02F1)] << 8));
            const uint16_t newMPD0 = (uint16_t)(m_mem[PM_V(0x0242)] | (m_mem[PM_V(0x0243)] << 8));
            PushStackWord(oldBASE);
            m_mem[PM_V(0x0244)] = newMPD0 & 0xFF; m_mem[PM_V(0x0245)] = newMPD0 >> 8;           // BASED0
            m_mem[PM_V(0x02F0)] = newMP & 0xFF;   m_mem[PM_V(0x02F1)] = newMP >> 8;             // BASE
            const uint16_t oldStatLink = (uint16_t)(m_mem[oldBASE] | (m_mem[(uint16_t)(oldBASE + 1)] << 8));
            m_mem[newMP] = oldStatLink & 0xFF; m_mem[(uint16_t)(newMP + 1)] = oldStatLink >> 8;
            m_cpu.r.setBC(newProcEntryAddr);
        } else {
            // msstat := the dynamic link of the frame whose creator is at the lex
            // level just below the callee's (as CIP: the dynamic chain, once per
            // active frame)
            const uint8_t targetLexLevel = (uint8_t)(calledLexLevel - 1);
            uint16_t examineAddr = newMP, result = 0;
            bool found = false;
            for (int iter = 0; iter < 30000; iter++) {
                const uint16_t frameJtab = (uint16_t)(m_mem[(uint16_t)(examineAddr + 4)] | (m_mem[(uint16_t)(examineAddr + 5)] << 8));
                const uint16_t frameDyn  = (uint16_t)(m_mem[(uint16_t)(examineAddr + 2)] | (m_mem[(uint16_t)(examineAddr + 3)] << 8));
                result = frameDyn;
                if (PM_CODE8((uint16_t)(frameJtab + 1)) == targetLexLevel) { found = true; break; }
                examineAddr = frameDyn;
            }
            if (!found) {                                             // not reachable for compiler-generated code:
                PushStackWord(newProcEntryAddr);                      // resume CIPXNL's loop in the Z80 code, as OP_CIP does
                m_cpu.r.A = targetLexLevel;
                m_cpu.r.setBC(examineAddr);
                m_cpu.r.PC = 0x137F;
                break;
            }
            m_mem[newMP] = result & 0xFF; m_mem[(uint16_t)(newMP + 1)] = result >> 8;           // replace msstat
            m_cpu.r.setBC(newProcEntryAddr);
        }
        commit = true;
        break;
    }
}
