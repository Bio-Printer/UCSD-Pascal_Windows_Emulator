  <ItemGroup>
    <!--
      Only pascal.bin (the Z80 loader / BIOS image) is copied to the output
      directory, via MSBuild's own Copy task (no cmd.exe quoting problems).
      It is read-only firmware: nothing ever writes to it.

      Disk VOLUMES are deliberately NOT copied.  The emulator mounts the
      volumes whose paths it remembers in the registry
      (HKCU\Software\EDN\UCSD Pascal II.0 Emulator\Volumes); choose them with
      File > Open Big Disk / Scratch / Unit 9 / Unit 10.  Copying volumes at
      build or start-up time (even PreserveNewest) could silently replace the
      volume you are working in with an older one.
    -->
    <None Include="..\data\pascal.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
