1D29|                       ;**********Compiler Intrinsics******
1D29|                       
1D29|                       ; idsearch(VAR symcursor: cursrange; symbufp: ^symbufarray)
1D29|                       
1D29|                       ; The following declaration order for the compiler is assumed, as IDSCH is
1D29|                       ;  passed only ^symcursor.
1D29|                       ;    symcursor: cursrange (* index into symbufarray *);
1D29|                       ;    sy: symbol (* symbol = (ident..othersy), set by info in reswrdtable *);
1D29|                       ;    op: operator (* more info from reswrdtable *);
1D29|                       ;    id: alfa (* packed array [1..8] of char, gets filled with first 8 chars
1D29|                       ;          of token isolated by IDSRCH if token is an identifier *);
1D29|                       
1D29|                       ; Isolate token, converting to upper case.
1D29|                       ; If token in reswrdtable set sy and op from table,
1D29|                       ; else set st := ident, and put first 8 chars (left-justified) of
1D29|                       ;   token into id.
1D29|                       ; symcursor is left pointing to the last char of the token
1D29|                       
1D29| 0290                  SYMCUR  .EQU    WORD1           ; index into symbufarray
1D29| 0292                  SYMBUFP .EQU    WORD2           ; ^symcursarray
1D29| 0294                  RESWRDP .EQU    WORD3           ; ^reswrdtable
1D29| 0296                  IDEND   .EQU    WORD4           ; loop control
1D29| 0298                  TOKEN   .EQU    BLOCK1          ; first 8 chars of isolated token goes here
1D29|                       
1D29|                       RESTBL  ; reswrdtable
1D29|                               ; TYPE table = RECORD
1D29|                               ;                indexes: ARRAY ['A'..succ('Z')] OF integer;
PAGE - 115  INTERP    FILE: STP.TEXT   


1D29|                               ;                tokens: ARRAY [0..#] OF RECORD
1D29|                               ;                          tokenname: alfa;
1D29|                               ;                          tokentype: symbol;
1D29|                               ;                          optype: operator
1D29|                               ;                        END
1D29|                               ;              END;
