0B82|                       ; The algorithm used to build the set...
0B82|                       ;   xx := bitter[j MOD 16];  t := j DIV 16;
0B82|                       ;   WHILE t>i DIV 16 DO
0B82|                       ;     BEGIN  push(xx);  xx := <all ones>;  t := t-1  END
