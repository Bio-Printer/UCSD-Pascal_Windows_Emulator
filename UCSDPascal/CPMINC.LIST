17B2|                       
17B2|                       ; Mark stack control word (MSCW) format:
17B2|                         
17B2| 000A                  MSSP    .EQU    +0AH            ; Caller's top of stack
17B2| 0008                  MSIPC   .EQU    +08H            ; Caller's IPC (return address)
17B2| 0006                  MSSEG   .EQU    +06H            ; Caller's segment (proc table) pointer
17B2| 0004                  MSJTAB  .EQU    +04H            ; Caller's jtab pointer
17B2| 0002                  MSDYN   .EQU    +02H            ; Dynamic link - pointer to caller's MSCW
17B2| 0000                  MSSTAT  .EQU    +00H            ; Static link - pointer to parent's MSCW
17B2| FFFE                  MSBASE  .EQU    -02H            ; Base link (only if CBP) - pointer
17B2|                                                       ; to base MSCW of caller
17B2|                         
17B2|                       ; Jump table (JTAB) format
17B2|                       ;       .EQU    +01H            ; lex level of proc
17B2|                       ;       .EQU     00H            ; proc-num
17B2| FFFE                  ENTRIC  .EQU    -02H            ; address of entry point (self-relative)
17B2| FFFC                  EXITIC  .EQU    -04H            ; address of exit code (self-relative)
17B2| FFFA                  PARMSZ  .EQU    -06H            ; number of bytes of parameters
17B2| FFF8                  DATASZ  .EQU    -08H            ; number of bytes of local data segment
17B2|                       ; -0AH to -08H-2*(# of long jumps)      self-relative jump address
17B2|                       
17B2|                       ;Proc table (pointed to by msseg) format
17B2|                       ;       .EQU    +01H            ; number of procs in segment
17B2|                       ;       .EQU     00H            ; seg_num
17B2|                       ;-02H to -2*(number of procs)   self-relative pointers to each procs JTAB
17B2|                       
17B2|                       
17B2|                       ; Seg table (part of syscom) format:
17B2|                       ;                00H            ; unit number code for seg is on
17B2|                       ;               +02H            ; block # code for seg starts at
17B2|                       ;               +04H            ; segment length (in bytes)
17B2|                       
17B2|                       ; Operator formats:
