0F76|                       
0F76|                               .MACRO   FPMPUSH         ; push the fp # residing at addr given
0F76|                                LD     HL,(%1 + 2)
0F76|                                PUSH   HL
0F76|                                LD     HL,(%1)
0F76|                                PUSH   HL
0F76|                               .ENDM
0F76|                               
0F76|                               .MACRO   FPMPOP          ; pop the fp tos into addr given 
0F76|                                POP    HL
0F76|                                LD     (%1),HL
0F76|                                POP    HL
0F76|                                LD     (%1 + 2),HL
0F76|                               .ENDM
0F76|                       
PAGE -  60  INTERP    FILE: FPI.TEXT   


0F76|                               .MACRO   FPMSAVE        ; save to fp tos into addr given
0F76|                                POP    DE              ;   leaves fp on tos, and in LHED
0F76|                                POP    HL
0F76|                                LD     (%1 + 2),HL
0F76|                                EX     DE,HL
0F76|                                LD     (%1),HL
0F76|                                PUSH   DE
0F76|                                PUSH   HL
0F76|                               .ENDM
0F76|                               
0F76|                                ; adjust stack which contains a ret addr
0F76|                                ; and one fp.  leave fp in LHED.  If addr
0F76|                                ; specified put arg into it.  If "junk"
0F76|                                ; specified (only legal if addr given)
0F76|                                ; then don't leave fp on stack.
0F76|                                .MACRO   FPMADJ        ; Adjust stack, which contains a ret. addr.
0F76|                                .IF "%1" = ""          ;   and one fp.  Leave fp in LHED.  If addr.
0F76|                                 POP   BC              ;   passed to macro stick fp in it, too.  If
0F76|                                 POP   HL              ;   "junk" passed (only legal is addr. is
0F76|                                 POP   DE              ;   given) then don't leave fp as tos, but
0F76|                                 PUSH  BC              ;   toss it away.
0F76|                                 PUSH  DE
0F76|                                 PUSH  HL
0F76|                                .ELSE
0F76|                                 POP   BC
0F76|                                 POP   DE
0F76|                                 POP   HL
0F76|                                 PUSH  BC
0F76|                                 LD    (%1 + 2),HL
0F76|                                 EX    DE,HL
0F76|                                 LD    (%1),HL
0F76|                                 .IF "%2" <> "JUNK"
0F76|                                  PUSH DE
0F76|                                  PUSH HL
0F76|                                 .ENDC
0F76|                                .ENDC
0F76|                               .ENDM
0F76|                               
0F76|                               .MACRO   FPMDUP          ; duplicate tos
0F76|                                .IF "%1" = "LHED"
0F76|                                 PUSH  DE
0F76|                                 PUSH  HL
0F76|                                .ENDC
0F76|                                .IF "%1" = "EDCB"
0F76|                                 PUSH  DE
0F76|                                 PUSH  HL
0F76|                                .ENDC
0F76|                                .IF "%1" = ""
0F76|                                 POP   HL
0F76|                                 POP   DE
0F76|                                 PUSH  DE
0F76|                                 PUSH  HL
0F76|                                 PUSH  DE
0F76|                                 PUSH  HL
0F76|                                .ENDC
PAGE -  61  INTERP    FILE: FPI.TEXT   


