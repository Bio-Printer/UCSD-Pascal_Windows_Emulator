2431|                       ;****************BOOTSTRAP LOADERS****************;
2431|                       
2431|                       ;    The special TEK bootstrap, which is for files that include both
2431|                       ;       the interpreter and the P-code program to execute.
2431|                       
2431|                               .IF     TEK
2431|                               .ENDC
2431|                       
2431|                       ;    The complex bootstrap.  So termed not because it is complex, but
2431|                       ;       because the primary booter that read in the interpreter also
2431|                       ;       initialized the P-machine, in a like manner to the booter below
2431|                       
2431| E1                    CBOOT   POP     HL              ; get UCSD bios location...
2432| 22 0302                       LD      (BIOSJP),HL     ; ...save it in a fixed place...
2435| C3 A403                       JP      BACK1           ; ...and start interpreting
2438|                       
2438|                       
2438|                       ;    The standard booter.  For primary booters that simply read in the interp
2438|                       ; This is a Pascal-system loader, it assumes that
2438|                       ;the complete interpreter and booter have been
2438|                       ;loaded by the host machine. It assumes that on
2438|                       ;unit 4 ,block 2 is a directory with the pascal
2438|                       ;operating system 'SYSTEM.PASCAL'. The booter
2438|                       ;reads this, initializes the interpreter to enter
2438|                       ;the system outer block and goes to it.
2438|                       
2438|                       ;     Six easy steps toward the realization of Pascal.
2438|                       ;  1: initialize all I/O drivers, size memory
2438|                       ;  2: read directory, find 'SYSTEM.PASCAL'
2438|                       ;  3: read block zero and set up SEGTBL
2438|                       ;  4: read in segment zero
2438|                       ;  5: set up machine state for seg 0 proc 1
2438|                       ;  6: GO FOR IT.
2438|                       
2438|                               ; These declarations are for Step 2.
2438| 0D                    SYSTLE  .BYTE   0DH             ;length byte of String
2439| 53 59 53 54 45 4D 2E          .ASCII  "SYSTEM.PASCAL" ;characters of String
2440| 50 41 53 43 41 4C     
2446| 001A                  DENTSZ  .EQU    1AH             ;directory entry size, bytes
2446| 0006                  DTITLE  .EQU    06H             ;offset of title in an entry
2446| 0000                  DENTP   .WORD   0               ;gets set by this Step
2448|                       
2448| 0000                  SYSBLK  .WORD   0  
244A| 00                    SEGCNT  .BYTE   0  
244B|                       
244B|                       
244B|                       BOOT    ;Start here and follow the yellow brick road.
244B| 31 ****                       LD      SP,RELSEG+1000H         ;if that doesn't do it I'll be
244E|                               
244E|                               ;   Step 1
PAGE - 135  INTERP    FILE: BOOT.TEXT   


