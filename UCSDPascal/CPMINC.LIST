0434* 6E04
046E|                       GBDE    ; get a big (possibly two byte) constant from code into DE
046E| 0A                            LD      A,(BC)
046F| 03                            INC     BC
0470| 5F                            LD      E,A             ; assume 1-byte...by far the most common case
0471| 16 00                         LD      D,00H
0473|                               TSTA
0473| A7                   #         AND    A
0474| F0                            RET     P               ; if bit 7 is zero, assumtion was correct
0475| E6 7F                         AND     7FH             ; clear bit 7
0477| 57                            LD      D,A             ; this is the high order byte
0478| 0A                            LD      A,(BC)          ; get lower
0479| 03                            INC     BC
047A| 5F                            LD      E,A
047B| C9                            RET
