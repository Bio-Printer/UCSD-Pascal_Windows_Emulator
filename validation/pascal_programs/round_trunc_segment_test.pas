PROGRAM RNDTEST;
VAR R: REAL; I: INTEGER;
SEGMENT PROCEDURE SEGPROC(X: INTEGER);
BEGIN
  WRITELN('IN SEGMENT ', X)
END;
BEGIN
WRITELN(ROUND(2.5), ' ', ROUND(-2.5), ' ', ROUND(2.4999), ' ', ROUND(-0.4), ' ', ROUND(1234.6));
R := 0.1;
WRITELN(ROUND(R), ' ', ROUND(R * 25.0), ' ', ROUND(-R * 35.0), ' ', ROUND(32766.7));
WRITELN(TRUNC(2.9), ' ', TRUNC(-2.9), ' ', TRUNC(32767.0), ' ', TRUNC(0.001));
SEGPROC(7);
SEGPROC(8);
END.
